{
  "name": "twerge-realtime-collab",
  "version": "1.0.0",
  "description": "Realtime collaborative dashboard demonstrating Twerge optimization",
  "scripts": {
    "dev": "concurrently \"npm run dev:css\" \"npm run dev:templ\" \"go run main.go\"",
    "dev:css": "tailwindcss -i input.css -o _static/dist/styles.css --watch",
    "dev:templ": "templ generate --watch",
    "build": "npm run generate && npm run build:css && templ generate",
    "build:css": "NODE_ENV=production tailwindcss -i input.css -o _static/dist/styles.css --minify",
    "generate": "go run gen.go",
    "start": "go run main.go",
    "lint": "npm run lint:css",
    "lint:css": "stylelint input.css",
    "clean": "rm -rf _static/dist classes/classes.go classes/classes.html"
  },
  "keywords": [
    "twerge",
    "tailwindcss",
    "go",
    "templ",
    "realtime",
    "collaboration",
    "websocket",
    "htmx"
  ],
  "devDependencies": {
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.10",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.32",
    "stylelint": "^16.0.2",
    "stylelint-config-standard": "^36.0.0",
    "tailwindcss": "^3.4.0"
  },
  "dependencies": {
    "alpinejs": "^3.13.3",
    "htmx.org": "^1.9.6"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/conneroisu/twerge.git",
    "directory": "examples/realtime-collab"
  },
  "author": "Conner Ohnesorge",
  "license": "MIT"
}