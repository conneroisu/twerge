package views

import (
	"fmt"
	"strconv"
	"github.com/conneroisu/twerge"
	"github.com/conneroisu/twerge/examples/ecommerce-catalog/types"
)

templ CatalogPage(
	products []types.Product,
	filters types.FilterState,
	totalProducts int,
	categoryCounts map[string]int,
	cartItems map[string]bool,
	favorites map[string]bool,
	cartCount int,
) {
	@Layout("Product Catalog", cartCount) {
		<div class={twerge.It("flex flex-col lg:flex-row gap-8")}>
			<!-- Mobile Filter Toggle -->
			<div class={twerge.It("lg:hidden")}>
				@MobileFilterToggle()
			</div>
			
			<!-- Filters Sidebar -->
			<aside class={twerge.It("lg:w-80 flex-shrink-0")}>
				<div class={twerge.It("sticky top-24")}>
					@FilterSidebar(filters, totalProducts, categoryCounts)
				</div>
			</aside>
			
			<!-- Main Content -->
			<main class={twerge.It("flex-1 min-w-0")}>
				<div id="catalog-content">
					@CatalogContent(products, filters, totalProducts, cartItems, favorites)
				</div>
			</main>
		</div>
	}
}

templ CatalogContent(
	products []types.Product,
	filters types.FilterState,
	totalProducts int,
	cartItems map[string]bool,
	favorites map[string]bool,
) {
	<div class={twerge.It("space-y-6")}>
		<!-- Header with Results Count and Sorting -->
		<div class={twerge.It("flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4")}>
			<div>
				<h1 class={twerge.It("text-2xl font-bold text-gray-900 dark:text-white")}>
					Products
				</h1>
				<p class={twerge.It("text-gray-600 dark:text-gray-400 mt-1")}>
					Showing { strconv.Itoa(len(products)) } of { strconv.Itoa(totalProducts) } products
				</p>
			</div>
			
			<!-- View Toggle and Sort -->
			<div class={twerge.It("flex items-center space-x-4")}>
				@ViewToggle("grid")
				@QuickSort(filters.SortBy)
			</div>
		</div>
		
		<!-- Active Filters -->
		@ActiveFilters(filters)
		
		<!-- Featured Products Banner -->
		if len(getFeaturedProducts(products)) > 0 {
			@FeaturedProductsBanner(getFeaturedProducts(products), cartItems, favorites)
		}
		
		<!-- Product Grid -->
		if len(products) == 0 {
			@NoProductsFound(filters)
		} else {
			@ProductGrid(products, cartItems, favorites)
		}
		
		<!-- Load More / Pagination -->
		if len(products) >= 20 {
			@LoadMoreButton(filters, len(products))
		}
	</div>
}

templ ViewToggle(currentView string) {
	<div class={twerge.It("flex rounded-lg border border-gray-300 dark:border-gray-600 p-1")}>
		<button 
			class={twerge.It(
				"p-2 rounded " +
				twerge.If(currentView == "grid",
					"bg-blue-600 text-white",
					"text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300"
				)
			)}
			hx-get="/catalog/products"
			hx-vals='{"view": "grid"}'
			hx-target="#catalog-content"
			hx-swap="innerHTML"
		>
			<svg class={twerge.It("w-5 h-5")} fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/>
			</svg>
		</button>
		<button 
			class={twerge.It(
				"p-2 rounded " +
				twerge.If(currentView == "list",
					"bg-blue-600 text-white",
					"text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300"
				)
			)}
			hx-get="/catalog/products"
			hx-vals='{"view": "list"}'
			hx-target="#catalog-content"
			hx-swap="innerHTML"
		>
			<svg class={twerge.It("w-5 h-5")} fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"/>
			</svg>
		</button>
	</div>
}

templ QuickSort(currentSort string) {
	<select 
		class={twerge.It("px-3 py-2 text-sm border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent")}
		hx-post="/catalog/filter"
		hx-target="#catalog-content"
		hx-swap="innerHTML"
		hx-trigger="change"
		name="sort_by"
	>
		<option value="relevance" selected={currentSort == "relevance"}>Sort by Relevance</option>
		<option value="price_asc" selected={currentSort == "price_asc"}>Price: Low to High</option>
		<option value="price_desc" selected={currentSort == "price_desc"}>Price: High to Low</option>
		<option value="rating" selected={currentSort == "rating"}>Highest Rated</option>
		<option value="newest" selected={currentSort == "newest"}>Newest First</option>
		<option value="name_asc" selected={currentSort == "name_asc"}>Name: A to Z</option>
	</select>
}

templ FeaturedProductsBanner(featuredProducts []types.Product, cartItems map[string]bool, favorites map[string]bool) {
	<div class={twerge.It("bg-gradient-to-r from-blue-600 to-purple-600 rounded-lg p-6 text-white mb-8")}>
		<div class={twerge.It("flex flex-col lg:flex-row lg:items-center lg:justify-between")}>
			<div class={twerge.It("mb-4 lg:mb-0")}>
				<h2 class={twerge.It("text-2xl font-bold mb-2")}>Featured Products</h2>
				<p class={twerge.It("text-blue-100")}>
					Hand-picked products with special deals and offers
				</p>
			</div>
			<div class={twerge.It("flex space-x-4 overflow-x-auto pb-2")}>
				for i, product := range featuredProducts {
					if i < 3 {
						@FeaturedProductCard(product, cartItems[product.ID], favorites[product.ID])
					}
				}
			</div>
		</div>
	</div>
}

templ FeaturedProductCard(product types.Product, inCart bool, favorited bool) {
	<div class={twerge.It("flex-shrink-0 w-48 bg-white dark:bg-gray-800 rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition-shadow duration-300")}>
		<div class={twerge.It("relative h-32")}>
			if len(product.Images) > 0 {
				<img 
					src={product.Images[0]} 
					alt={product.Name}
					class={twerge.It("w-full h-full object-cover")}
				/>
			}
			if product.SalePrice != nil {
				<span class={twerge.It("absolute top-2 right-2 bg-red-500 text-white text-xs font-bold px-2 py-1 rounded-full")}>
					{ fmt.Sprintf("%.0f%% OFF", (1-*product.SalePrice/product.Price)*100) }
				</span>
			}
		</div>
		<div class={twerge.It("p-3")}>
			<h3 class={twerge.It("font-medium text-gray-900 dark:text-white text-sm line-clamp-2 mb-2")}>
				{ product.Name }
			</h3>
			<div class={twerge.It("flex items-center justify-between")}>
				<div>
					if product.SalePrice != nil {
						<span class={twerge.It("text-lg font-bold text-red-600 dark:text-red-400")}>
							${ fmt.Sprintf("%.2f", *product.SalePrice) }
						</span>
					} else {
						<span class={twerge.It("text-lg font-bold text-gray-900 dark:text-white")}>
							${ fmt.Sprintf("%.2f", product.Price) }
						</span>
					}
				</div>
				@QuickAddButton(product.ID, "small")
			</div>
		</div>
	</div>
}

templ NoProductsFound(filters types.FilterState) {
	<div class={twerge.It("text-center py-16")}>
		<svg class={twerge.It("mx-auto h-16 w-16 text-gray-400 mb-4")} fill="none" stroke="currentColor" viewBox="0 0 24 24">
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
		</svg>
		<h3 class={twerge.It("text-lg font-medium text-gray-900 dark:text-white mb-2")}>
			No products found
		</h3>
		<p class={twerge.It("text-gray-500 dark:text-gray-400 mb-6")}>
			Try adjusting your filters or search terms to find what you're looking for.
		</p>
		<button 
			class={twerge.It("px-6 py-2 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700 transition-colors duration-200")}
			hx-post="/catalog/filter"
			hx-vals="{}"
			hx-target="#catalog-content"
			hx-swap="innerHTML"
		>
			Clear All Filters
		</button>
	</div>
}

templ LoadMoreButton(filters types.FilterState, currentCount int) {
	<div class={twerge.It("text-center mt-12")}>
		<button 
			class={twerge.It(
				"px-8 py-3 bg-white dark:bg-gray-800 border-2 border-gray-300 dark:border-gray-600 " +
				"text-gray-700 dark:text-gray-300 font-medium rounded-lg " +
				"hover:border-gray-400 dark:hover:border-gray-500 hover:bg-gray-50 dark:hover:bg-gray-700 " +
				"transition-all duration-200 transform hover:scale-105"
			)}
			hx-get="/catalog/products"
			hx-vals={fmt.Sprintf(`{"offset": %d}`, currentCount)}
			hx-target="#product-grid"
			hx-swap="beforeend"
			hx-indicator=".load-more-spinner"
		>
			<div class="load-more-spinner htmx-indicator">
				<svg class={twerge.It("animate-spin h-5 w-5 mr-2")} fill="none" viewBox="0 0 24 24">
					<circle class={twerge.It("opacity-25")} cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
					<path class={twerge.It("opacity-75")} fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
				</svg>
			</div>
			Load More Products
		</button>
	</div>
}

templ ProductDetail(product types.Product, selectedVariants map[string]string, cartItems map[string]bool, cartCount int) {
	@Layout(product.Name, cartCount) {
		<div class={twerge.It("max-w-7xl mx-auto")}>
			<!-- Breadcrumb -->
			<nav class={twerge.It("mb-8")}>
				<ol class={twerge.It("flex items-center space-x-2 text-sm")}>
					<li><a href="/" class={twerge.It("text-blue-600 hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300")}>Home</a></li>
					<li class={twerge.It("text-gray-500 dark:text-gray-400")}>›</li>
					<li><a href={templ.URL("/?category=" + product.Category)} class={twerge.It("text-blue-600 hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300")}>{ product.Category }</a></li>
					<li class={twerge.It("text-gray-500 dark:text-gray-400")}>›</li>
					<li class={twerge.It("text-gray-700 dark:text-gray-300")}>{ product.Name }</li>
				</ol>
			</nav>
			
			<div class={twerge.It("grid grid-cols-1 lg:grid-cols-2 gap-12")}>
				<!-- Product Images -->
				<div class={twerge.It("space-y-4")}>
					@ProductImageGallery(product.Images)
				</div>
				
				<!-- Product Info -->
				<div class={twerge.It("space-y-6")}>
					<!-- Title and Price -->
					<div>
						<h1 class={twerge.It("text-3xl font-bold text-gray-900 dark:text-white mb-2")}>
							{ product.Name }
						</h1>
						<div class={twerge.It("flex items-center space-x-4 mb-4")}>
							if product.SalePrice != nil {
								<span class={twerge.It("text-3xl font-bold text-red-600 dark:text-red-400")}>
									${ fmt.Sprintf("%.2f", *product.SalePrice) }
								</span>
								<span class={twerge.It("text-xl text-gray-500 line-through")}>
									${ fmt.Sprintf("%.2f", product.Price) }
								</span>
								<span class={twerge.It("bg-red-500 text-white text-sm font-bold px-2 py-1 rounded-full")}>
									{ fmt.Sprintf("%.0f%% OFF", (1-*product.SalePrice/product.Price)*100) }
								</span>
							} else {
								<span class={twerge.It("text-3xl font-bold text-gray-900 dark:text-white")}>
									${ fmt.Sprintf("%.2f", product.Price) }
								</span>
							}
						</div>
						
						<!-- Rating and Reviews -->
						if product.Rating > 0 {
							<div class={twerge.It("flex items-center space-x-4")}>
								<div class={twerge.It("flex items-center")}>
									for i := 1; i <= 5; i++ {
										<svg 
											class={twerge.It(
												"w-5 h-5 " +
												twerge.If(float64(i) <= product.Rating, "text-yellow-400", "text-gray-300")
											)}
											fill="currentColor" 
											viewBox="0 0 20 20"
										>
											<path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
										</svg>
									}
								</div>
								<span class={twerge.It("text-gray-600 dark:text-gray-400")}>
									({ strconv.Itoa(product.Reviews) } reviews)
								</span>
							</div>
						}
					</div>
					
					<!-- Description -->
					<div>
						<h3 class={twerge.It("text-lg font-semibold text-gray-900 dark:text-white mb-2")}>Description</h3>
						<p class={twerge.It("text-gray-600 dark:text-gray-400 leading-relaxed")}>
							{ product.Description }
						</p>
					</div>
					
					<!-- Variants -->
					if len(product.Variants) > 0 {
						@ProductVariantSelectors(product, selectedVariants)
					}
					
					<!-- Stock Status -->
					<div class={twerge.It("flex items-center space-x-2")}>
						if product.InStock {
							<svg class={twerge.It("w-5 h-5 text-green-500")} fill="currentColor" viewBox="0 0 20 20">
								<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
							</svg>
							<span class={twerge.It("text-green-700 dark:text-green-400 font-medium")}>In Stock</span>
						} else {
							<svg class={twerge.It("w-5 h-5 text-red-500")} fill="currentColor" viewBox="0 0 20 20">
								<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
							</svg>
							<span class={twerge.It("text-red-700 dark:text-red-400 font-medium")}>Out of Stock</span>
						}
					</div>
					
					<!-- Add to Cart -->
					@AddToCartButton(product, cartItems[product.ID], false)
				</div>
			</div>
		</div>
	}
}

templ ProductImageGallery(images []string) {
	<div x-data="{ selectedImage: 0 }" class={twerge.It("space-y-4")}>
		<!-- Main Image -->
		<div class={twerge.It("aspect-square rounded-lg overflow-hidden bg-gray-100 dark:bg-gray-800")}>
			if len(images) > 0 {
				<img 
					:src={fmt.Sprintf("images[selectedImage] || '%s'", images[0])}
					alt="Product image"
					class={twerge.It("w-full h-full object-cover")}
					x-init={fmt.Sprintf("images = %v", toJSArray(images))}
				/>
			} else {
				<div class={twerge.It("w-full h-full flex items-center justify-center")}>
					<svg class={twerge.It("w-24 h-24 text-gray-400")} fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
					</svg>
				</div>
			}
		</div>
		
		<!-- Thumbnail Images -->
		if len(images) > 1 {
			<div class={twerge.It("grid grid-cols-4 gap-4")}>
				for i, image := range images {
					<button 
						@click={fmt.Sprintf("selectedImage = %d", i)}
						class={twerge.It("aspect-square rounded-lg overflow-hidden border-2 transition-colors duration-200")}
						:class={fmt.Sprintf("selectedImage === %d ? 'border-blue-500' : 'border-gray-300 dark:border-gray-600 hover:border-gray-400 dark:hover:border-gray-500'", i)}
					>
						<img 
							src={image}
							alt={fmt.Sprintf("Product image %d", i+1)}
							class={twerge.It("w-full h-full object-cover")}
						/>
					</button>
				}
			</div>
		}
	</div>
}

func getFeaturedProducts(products []types.Product) []types.Product {
	featured := make([]types.Product, 0)
	for _, product := range products {
		if product.Featured {
			featured = append(featured, product)
		}
	}
	return featured
}

func toJSArray(strings []string) string {
	if len(strings) == 0 {
		return "[]"
	}
	result := "["
	for i, str := range strings {
		if i > 0 {
			result += ", "
		}
		result += "'" + str + "'"
	}
	result += "]"
	return result
}