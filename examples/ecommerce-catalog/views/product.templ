package views

import (
	"fmt"
	"strconv"
	"github.com/conneroisu/twerge"
	"github.com/conneroisu/twerge/examples/ecommerce-catalog/types"
)

func getColorClass(color string) string {
	if class, exists := types.ColorMap[color]; exists {
		return class
	}
	return "bg-gray-500"
}

templ ProductCard(product types.Product, inCart bool, favorited bool) {
	<div class={twerge.It(
		"group relative bg-white dark:bg-gray-800 rounded-xl shadow-sm hover:shadow-lg " +
		"transition-all duration-300 overflow-hidden border border-gray-200 dark:border-gray-700 " +
		"hover:border-gray-300 dark:hover:border-gray-600 " +
		twerge.If(product.Featured, "ring-2 ring-blue-500 ring-opacity-50", "") +
		twerge.If(!product.InStock, "opacity-75 grayscale", "")
	)}>
		<!-- Product Image with Overlay -->
		<div class={twerge.It("relative aspect-square overflow-hidden")}>
			if len(product.Images) > 0 {
				<img 
					src={product.Images[0]} 
					alt={product.Name}
					class={twerge.It(
						"w-full h-full object-cover transition-transform duration-500 " +
						"group-hover:scale-110"
					)}
				/>
			} else {
				<div class={twerge.It("w-full h-full bg-gray-200 dark:bg-gray-700 flex items-center justify-center")}>
					<svg class={twerge.It("w-16 h-16 text-gray-400")} fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
					</svg>
				</div>
			}
			
			<!-- Quick Actions Overlay -->
			<div class={twerge.It(
				"absolute inset-0 bg-black bg-opacity-0 group-hover:bg-opacity-20 " +
				"transition-all duration-300 flex items-center justify-center"
			)}>
				<div class={twerge.It(
					"flex space-x-2 transform translate-y-4 opacity-0 " +
					"group-hover:translate-y-0 group-hover:opacity-100 " +
					"transition-all duration-300"
				)}>
					@QuickActionButton("Quick View", "eye", fmt.Sprintf("/products/%s", product.ID))
					@QuickActionButton(
						twerge.If(favorited, "Remove from Wishlist", "Add to Wishlist"), 
						twerge.If(favorited, "heart-filled", "heart"),
						"#"
					)
				</div>
			</div>

			<!-- Stock Status Badge -->
			if !product.InStock {
				<div class={twerge.It(
					"absolute top-2 left-2 bg-red-500 text-white text-xs font-medium " +
					"px-2 py-1 rounded-full"
				)}>
					Out of Stock
				</div>
			}

			<!-- Sale Badge -->
			if product.SalePrice != nil {
				<div class={twerge.It(
					"absolute top-2 right-2 bg-red-500 text-white text-xs font-bold " +
					"px-2 py-1 rounded-full animate-pulse"
				)}>
					{ fmt.Sprintf("%.0f%% OFF", (1-*product.SalePrice/product.Price)*100) }
				</div>
			}

			<!-- Featured Badge -->
			if product.Featured {
				<div class={twerge.It(
					"absolute top-2 left-2 bg-blue-500 text-white text-xs font-medium " +
					"px-2 py-1 rounded-full"
				)}>
					Featured
				</div>
			}
		</div>

		<!-- Product Info -->
		<div class={twerge.It("p-4 space-y-3")}>
			<h3 class={twerge.It(
				"font-semibold text-gray-900 dark:text-white group-hover:text-blue-600 " +
				"dark:group-hover:text-blue-400 transition-colors duration-200 " +
				"line-clamp-2"
			)}>
				{ product.Name }
			</h3>

			<!-- Category -->
			<p class={twerge.It("text-xs text-gray-500 dark:text-gray-400 uppercase tracking-wide")}>
				{ product.Category }
			</p>

			<!-- Rating -->
			if product.Rating > 0 {
				<div class={twerge.It("flex items-center space-x-2")}>
					<div class={twerge.It("flex items-center")}>
						for i := 1; i <= 5; i++ {
							<svg 
								class={twerge.It(
									"w-4 h-4 " +
									twerge.If(float64(i) <= product.Rating, "text-yellow-400", "text-gray-300")
								)}
								fill="currentColor" 
								viewBox="0 0 20 20"
							>
								<path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
							</svg>
						}
					</div>
					<span class={twerge.It("text-sm text-gray-500 dark:text-gray-400")}>
						({ strconv.Itoa(product.Reviews) })
					</span>
				</div>
			}

			<!-- Price Display -->
			<div class={twerge.It("flex items-center space-x-2")}>
				if product.SalePrice != nil {
					<span class={twerge.It("text-lg font-bold text-red-600 dark:text-red-400")}>
						${ fmt.Sprintf("%.2f", *product.SalePrice) }
					</span>
					<span class={twerge.It("text-sm text-gray-500 line-through")}>
						${ fmt.Sprintf("%.2f", product.Price) }
					</span>
				} else {
					<span class={twerge.It("text-lg font-bold text-gray-900 dark:text-white")}>
						${ fmt.Sprintf("%.2f", product.Price) }
					</span>
				}
			</div>

			<!-- Variants Preview -->
			if len(product.Variants) > 0 {
				@VariantsPreview(product.Variants)
			}

			<!-- Add to Cart Button -->
			<button 
				class={twerge.It(
					"w-full py-2 px-4 rounded-lg font-medium transition-all duration-200 " +
					twerge.If(product.InStock,
						twerge.If(inCart,
							"bg-green-100 text-green-700 border border-green-300 " +
							"hover:bg-green-200 dark:bg-green-900 dark:text-green-300 " +
							"dark:border-green-700 dark:hover:bg-green-800",
							"bg-blue-600 text-white hover:bg-blue-700 " +
							"active:bg-blue-800 transform hover:scale-105 active:scale-95"
						),
						"bg-gray-300 text-gray-500 cursor-not-allowed dark:bg-gray-700 dark:text-gray-400"
					)
				)}
				disabled={!product.InStock}
				hx-post={fmt.Sprintf("/cart/add/%s", product.ID)}
				hx-target="#toast-container"
				hx-swap="afterbegin"
			>
				if !product.InStock {
					Out of Stock
				} else if inCart {
					✓ In Cart
				} else {
					Add to Cart
				}
			</button>
		</div>
	</div>
}

templ QuickActionButton(title string, icon string, href string) {
	<a 
		href={templ.URL(href)}
		class={twerge.It(
			"p-2 bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-300 " +
			"rounded-full shadow-lg hover:shadow-xl transform hover:scale-110 " +
			"transition-all duration-200 hover:text-blue-600 dark:hover:text-blue-400"
		)}
		title={title}
	>
		if icon == "eye" {
			<svg class={twerge.It("w-5 h-5")} fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
			</svg>
		} else if icon == "heart" {
			<svg class={twerge.It("w-5 h-5")} fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
			</svg>
		} else if icon == "heart-filled" {
			<svg class={twerge.It("w-5 h-5 text-red-500")} fill="currentColor" viewBox="0 0 20 20">
				<path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"/>
			</svg>
		}
	</a>
}

templ VariantsPreview(variants []types.ProductVariant) {
	<div class={twerge.It("flex items-center space-x-2")}>
		<!-- Color variants preview -->
		<div class={twerge.It("flex space-x-1")}>
			for i, variant := range variants {
				if variant.Type == "color" && i < 4 {
					<div 
						class={twerge.It(
							"w-4 h-4 rounded-full border-2 border-gray-300 dark:border-gray-600 " +
							getColorClass(variant.Value) +
							twerge.If(!variant.Available, " opacity-50", "")
						)}
						title={variant.Value}
					></div>
				}
			}
		</div>
		
		<!-- Size variants preview -->
		<div class={twerge.It("flex space-x-1")}>
			for i, variant := range variants {
				if variant.Type == "size" && i < 3 {
					<span class={twerge.It(
						"text-xs px-1 py-0.5 bg-gray-100 dark:bg-gray-700 " +
						"text-gray-700 dark:text-gray-300 rounded " +
						twerge.If(!variant.Available, "opacity-50", "")
					)}>
						{ variant.Value }
					</span>
				}
			}
		</div>
		
		<!-- More variants indicator -->
		if len(variants) > 6 {
			<span class={twerge.It("text-xs text-gray-500 dark:text-gray-400")}>
				+{ strconv.Itoa(len(variants) - 6) } more
			</span>
		}
	</div>
}

templ ProductGrid(products []types.Product, cartItems map[string]bool, favorites map[string]bool) {
	<div 
		id="product-grid"
		class={twerge.It("grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6")}
	>
		for _, product := range products {
			@ProductCard(product, cartItems[product.ID], favorites[product.ID])
		}
	</div>
}