package views

import (
	"strings"
	"fmt"
	"github.com/conneroisu/twerge"
	"github.com/conneroisu/twerge/examples/ecommerce-catalog/types"
)

templ VariantSelector(variants []types.ProductVariant, selected string, variantType string, productID string) {
	<div class={twerge.It("space-y-3")}>
		<h4 class={twerge.It("text-sm font-medium text-gray-900 dark:text-white capitalize")}>
			{ variantType }
		</h4>
		
		<div class={twerge.It(
			twerge.If(variantType == "color", 
				"flex flex-wrap gap-2",
				"grid grid-cols-3 sm:grid-cols-4 lg:grid-cols-6 gap-2"
			)
		)}>
			for _, variant := range variants {
				if variant.Type == variantType {
					@VariantOption(variant, selected == variant.Value, variantType, productID)
				}
			}
		</div>
	</div>
}

templ VariantOption(variant types.ProductVariant, isSelected bool, variantType string, productID string) {
	<button 
		class={twerge.It(
			"relative transition-all duration-200 " +
			twerge.If(variantType == "color",
				"w-8 h-8 rounded-full border-2 " +
				twerge.If(variant.Available,
					twerge.If(isSelected,
						"border-gray-900 dark:border-white ring-2 ring-offset-2 ring-blue-500",
						"border-gray-300 dark:border-gray-600 hover:border-gray-400"
					),
					"border-gray-200 opacity-50 cursor-not-allowed"
				),
				// Size/Style variants
				"px-3 py-2 text-sm font-medium rounded-lg border " +
				twerge.If(variant.Available,
					twerge.If(isSelected,
						"bg-blue-600 text-white border-blue-600",
						"bg-white dark:bg-gray-800 text-gray-900 dark:text-white " +
						"border-gray-300 dark:border-gray-600 hover:border-gray-400 " +
						"hover:bg-gray-50 dark:hover:bg-gray-700"
					),
					"bg-gray-100 dark:bg-gray-800 text-gray-400 dark:text-gray-500 " +
					"border-gray-200 dark:border-gray-700 cursor-not-allowed line-through"
				)
			)
		)}
		disabled={!variant.Available}
		hx-post={fmt.Sprintf("/products/%s/variants", productID)}
		hx-vals={fmt.Sprintf(`{"type": "%s", "value": "%s"}`, variantType, variant.Value)}
		hx-target="#variant-selector-container"
		hx-swap="innerHTML"
		hx-trigger="click"
		title={twerge.If(variant.Available, variant.Value, variant.Value + " (Out of Stock)")}
	>
		if variantType == "color" {
			<div class={twerge.It(
				"w-full h-full rounded-full " +
				getColorClass(variant.Value)
			)}></div>
		} else {
			{ variant.Value }
			if variant.Price != nil {
				<span class={twerge.It("block text-xs text-gray-500 dark:text-gray-400")}>
					+${ fmt.Sprintf("%.2f", *variant.Price) }
				</span>
			}
		}
		
		if !variant.Available {
			<div class={twerge.It(
				"absolute inset-0 flex items-center justify-center " +
				"bg-white bg-opacity-80 dark:bg-gray-800 dark:bg-opacity-80 rounded-full"
			)}>
				<svg class={twerge.It("w-4 h-4 text-red-500")} fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
				</svg>
			</div>
		}
		
		<!-- Selection indicator for non-color variants -->
		if variantType != "color" && isSelected {
			<div class={twerge.It("absolute -top-1 -right-1 w-3 h-3 bg-blue-600 rounded-full flex items-center justify-center")}>
				<svg class={twerge.It("w-2 h-2 text-white")} fill="currentColor" viewBox="0 0 20 20">
					<path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
				</svg>
			</div>
		}
	</button>
}

templ ProductVariantSelectors(product types.Product, selectedVariants map[string]string) {
	<div id="variant-selector-container" class={twerge.It("space-y-6")}>
		// Group variants by type
		for _, variantType := range []string{"color", "size", "style"} {
			if hasVariantType(product.Variants, variantType) {
				@VariantSelector(
					product.Variants, 
					selectedVariants[variantType], 
					variantType,
					product.ID
				)
			}
		}
		
		// Selected variants summary
		if len(selectedVariants) > 0 {
			@SelectedVariantsSummary(selectedVariants, product.Variants)
		}
	</div>
}

templ SelectedVariantsSummary(selectedVariants map[string]string, allVariants []types.ProductVariant) {
	<div class={twerge.It("mt-4 p-3 bg-gray-50 dark:bg-gray-700 rounded-lg")}>
		<h5 class={twerge.It("text-sm font-medium text-gray-900 dark:text-white mb-2")}>
			Selected Options:
		</h5>
		<div class={twerge.It("flex flex-wrap gap-2")}>
			for variantType, value := range selectedVariants {
				if value != "" {
					// Find the variant to get additional pricing info
					for _, variant := range allVariants {
						if variant.Type == variantType && variant.Value == value {
							<div class={twerge.It(
								"inline-flex items-center space-x-2 px-3 py-1 bg-white dark:bg-gray-800 " +
								"border border-gray-200 dark:border-gray-600 rounded-full text-sm"
							)}>
								<span class={twerge.It("font-medium text-gray-900 dark:text-white capitalize")}>
									{ variantType }:
								</span>
								<span class={twerge.It("text-gray-700 dark:text-gray-300")}>
									{ value }
								</span>
								if variant.Price != nil {
									<span class={twerge.It("text-green-600 dark:text-green-400 font-medium")}>
										+${ fmt.Sprintf("%.2f", *variant.Price) }
									</span>
								}
							</div>
							break
						}
					}
				}
			}
		</div>
	</div>
}

templ VariantAvailabilityAlert(variantType string, value string, available bool) {
	<div class={twerge.It(
		"mt-2 p-2 rounded-lg text-sm " +
		twerge.If(available,
			"bg-green-50 dark:bg-green-900/20 text-green-800 dark:text-green-200 border border-green-200 dark:border-green-800",
			"bg-red-50 dark:bg-red-900/20 text-red-800 dark:text-red-200 border border-red-200 dark:border-red-800"
		)
	)}>
		<div class={twerge.It("flex items-center space-x-2")}>
			if available {
				<svg class={twerge.It("w-4 h-4")} fill="currentColor" viewBox="0 0 20 20">
					<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
				</svg>
				<span>{ strings.Title(variantType) } "{ value }" is available</span>
			} else {
				<svg class={twerge.It("w-4 h-4")} fill="currentColor" viewBox="0 0 20 20">
					<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
				</svg>
				<span>{ strings.Title(variantType) } "{ value }" is currently out of stock</span>
			}
		</div>
	</div>
}

templ QuickVariantSelector(variants []types.ProductVariant, variantType string, productID string) {
	// Compact variant selector for product cards or quick views
	<div class={twerge.It("flex items-center space-x-1")}>
		for i, variant := range variants {
			if variant.Type == variantType && i < 5 {
				if variantType == "color" {
					<button 
						class={twerge.It(
							"w-6 h-6 rounded-full border-2 border-gray-300 dark:border-gray-600 " +
							"hover:border-gray-400 dark:hover:border-gray-500 transition-colors duration-200 " +
							getColorClass(variant.Value) +
							twerge.If(!variant.Available, " opacity-50 cursor-not-allowed", "")
						)}
						disabled={!variant.Available}
						hx-post={fmt.Sprintf("/products/%s/variants", productID)}
						hx-vals={fmt.Sprintf(`{"type": "%s", "value": "%s"}`, variantType, variant.Value)}
						hx-target="#product-details"
						hx-swap="innerHTML"
						title={variant.Value}
					></button>
				} else {
					<button 
						class={twerge.It(
							"px-2 py-1 text-xs rounded border border-gray-300 dark:border-gray-600 " +
							"hover:border-gray-400 dark:hover:border-gray-500 transition-colors duration-200 " +
							"bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-300 " +
							twerge.If(!variant.Available, "opacity-50 cursor-not-allowed line-through", "")
						)}
						disabled={!variant.Available}
						hx-post={fmt.Sprintf("/products/%s/variants", productID)}
						hx-vals={fmt.Sprintf(`{"type": "%s", "value": "%s"}`, variantType, variant.Value)}
						hx-target="#product-details"
						hx-swap="innerHTML"
						title={variant.Value}
					>
						{ variant.Value }
					</button>
				}
			}
		}
		if len(variants) > 5 {
			<span class={twerge.It("text-xs text-gray-500 dark:text-gray-400")}>
				+{ fmt.Sprintf("%d", len(variants) - 5) }
			</span>
		}
	</div>
}

func hasVariantType(variants []types.ProductVariant, variantType string) bool {
	for _, variant := range variants {
		if variant.Type == variantType {
			return true
		}
	}
	return false
}