package views

import (
	"strings"
	"strconv"
	"fmt"
	"github.com/conneroisu/twerge"
	"github.com/conneroisu/twerge/examples/ecommerce-catalog/types"
)

templ CartDrawer(cart types.Cart, isOpen bool) {
	<div 
		class={twerge.It(
			"fixed inset-0 z-50 overflow-hidden " +
			twerge.If(isOpen, "block", "hidden")
		)}
		x-data={fmt.Sprintf("{ open: %t }", isOpen)}
		x-show="open"
		x-transition
	>
		<!-- Backdrop -->
		<div 
			class={twerge.It("absolute inset-0 bg-black bg-opacity-50")}
			@click="open = false"
		></div>
		
		<!-- Drawer -->
		<div class={twerge.It("absolute right-0 top-0 h-full w-full max-w-md bg-white dark:bg-gray-800 shadow-xl")}>
			<div class={twerge.It("flex h-full flex-col")}>
				<!-- Header -->
				<div class={twerge.It("flex items-center justify-between p-4 border-b border-gray-200 dark:border-gray-700")}>
					<h2 class={twerge.It("text-lg font-semibold text-gray-900 dark:text-white")}>
						Shopping Cart ({ strconv.Itoa(len(cart.Items)) })
					</h2>
					<button 
						class={twerge.It("p-2 text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 transition-colors duration-200")}
						@click="open = false"
					>
						<svg class={twerge.It("w-6 h-6")} fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
						</svg>
					</button>
				</div>
				
				<!-- Cart Items -->
				<div class={twerge.It("flex-1 overflow-y-auto p-4")}>
					if len(cart.Items) == 0 {
						@EmptyCart()
					} else {
						<div class={twerge.It("space-y-4")}>
							for _, item := range cart.Items {
								@CartItem(item, false)
							}
						</div>
					}
				</div>
				
				<!-- Footer -->
				if len(cart.Items) > 0 {
					@CartFooter(cart)
				}
			</div>
		</div>
	</div>
}

templ CartItem(item types.CartItem, updating bool) {
	<div 
		class={twerge.It(
			"flex items-center space-x-4 p-4 bg-white dark:bg-gray-800 rounded-lg " +
			"border border-gray-200 dark:border-gray-700 " +
			"transition-all duration-300 " +
			twerge.If(updating, "opacity-50 pointer-events-none", "")
		)}
		id={fmt.Sprintf("cart-item-%s", item.ID)}
	>
		<!-- Product Image -->
		<div class={twerge.It("relative w-16 h-16 flex-shrink-0 rounded-lg overflow-hidden")}>
			if len(item.Product.Images) > 0 {
				<img 
					src={item.Product.Images[0]} 
					alt={item.Product.Name}
					class={twerge.It("w-full h-full object-cover")}
				/>
			} else {
				<div class={twerge.It("w-full h-full bg-gray-200 dark:bg-gray-700 flex items-center justify-center")}>
					<svg class={twerge.It("w-6 h-6 text-gray-400")} fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
					</svg>
				</div>
			}
			if updating {
				<div class={twerge.It(
					"absolute inset-0 bg-white bg-opacity-75 dark:bg-gray-800 " +
					"dark:bg-opacity-75 flex items-center justify-center"
				)}>
					<div class={twerge.It("animate-spin h-4 w-4 border-2 border-blue-500 border-t-transparent rounded-full")}></div>
				</div>
			}
		</div>

		<!-- Product Details -->
		<div class={twerge.It("flex-1 min-w-0 space-y-1")}>
			<h4 class={twerge.It("font-medium text-gray-900 dark:text-white truncate")}>
				{ item.Product.Name }
			</h4>
			if len(item.SelectedVariants) > 0 {
				<p class={twerge.It("text-sm text-gray-500 dark:text-gray-400")}>
					{ strings.Join(item.SelectedVariants, ", ") }
				</p>
			}
			<p class={twerge.It("text-sm font-medium text-gray-900 dark:text-white")}>
				${ fmt.Sprintf("%.2f", item.Price) }
			</p>
		</div>

		<!-- Quantity Controls -->
		<div class={twerge.It("flex items-center space-x-2")}>
			<button 
				class={twerge.It(
					"w-8 h-8 rounded-full bg-gray-100 dark:bg-gray-700 " +
					"hover:bg-gray-200 dark:hover:bg-gray-600 " +
					"flex items-center justify-center transition-colors duration-200 " +
					twerge.If(item.Quantity <= 1, "opacity-50 cursor-not-allowed", "")
				)}
				disabled={item.Quantity <= 1}
				hx-patch={fmt.Sprintf("/cart/update/%s", item.ID)}
				hx-vals={fmt.Sprintf(`{"quantity": %d}`, item.Quantity-1)}
				hx-target={fmt.Sprintf("#cart-item-%s", item.ID)}
				hx-swap="outerHTML"
			>
				<svg class={twerge.It("w-4 h-4")} fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4"/>
				</svg>
			</button>
			
			<span class={twerge.It(
				"w-8 text-center font-medium text-gray-900 dark:text-white " +
				"transition-all duration-200 " +
				twerge.If(updating, "animate-pulse", "")
			)}>
				{ strconv.Itoa(item.Quantity) }
			</span>
			
			<button 
				class={twerge.It(
					"w-8 h-8 rounded-full bg-gray-100 dark:bg-gray-700 " +
					"hover:bg-gray-200 dark:hover:bg-gray-600 " +
					"flex items-center justify-center transition-colors duration-200"
				)}
				hx-patch={fmt.Sprintf("/cart/update/%s", item.ID)}
				hx-vals={fmt.Sprintf(`{"quantity": %d}`, item.Quantity+1)}
				hx-target={fmt.Sprintf("#cart-item-%s", item.ID)}
				hx-swap="outerHTML"
			>
				<svg class={twerge.It("w-4 h-4")} fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
				</svg>
			</button>
		</div>

		<!-- Remove Button -->
		<button 
			class={twerge.It(
				"text-red-500 hover:text-red-700 dark:text-red-400 " +
				"dark:hover:text-red-300 transition-colors duration-200 p-1"
			)}
			hx-delete={fmt.Sprintf("/cart/remove/%s", item.ID)}
			hx-target={fmt.Sprintf("#cart-item-%s", item.ID)}
			hx-swap="outerHTML swap:1s"
			hx-confirm="Remove this item from your cart?"
		>
			<svg class={twerge.It("w-5 h-5")} fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
			</svg>
		</button>
	</div>
}

templ EmptyCart() {
	<div class={twerge.It("flex flex-col items-center justify-center py-12 text-center")}>
		<svg class={twerge.It("w-16 h-16 text-gray-400 mb-4")} fill="none" stroke="currentColor" viewBox="0 0 24 24">
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
		</svg>
		<h3 class={twerge.It("text-lg font-medium text-gray-900 dark:text-white mb-2")}>
			Your cart is empty
		</h3>
		<p class={twerge.It("text-gray-500 dark:text-gray-400 mb-6")}>
			Add some products to get started!
		</p>
		<button 
			class={twerge.It(
				"px-6 py-2 bg-blue-600 text-white font-medium rounded-lg " +
				"hover:bg-blue-700 transition-colors duration-200"
			)}
			@click="open = false"
		>
			Continue Shopping
		</button>
	</div>
}

templ CartFooter(cart types.Cart) {
	<div class={twerge.It("border-t border-gray-200 dark:border-gray-700 p-4 space-y-4")}>
		<!-- Order Summary -->
		<div class={twerge.It("space-y-2")}>
			<div class={twerge.It("flex justify-between text-sm")}>
				<span class={twerge.It("text-gray-600 dark:text-gray-400")}>Subtotal</span>
				<span class={twerge.It("text-gray-900 dark:text-white")}>
					${ fmt.Sprintf("%.2f", cart.Subtotal) }
				</span>
			</div>
			<div class={twerge.It("flex justify-between text-sm")}>
				<span class={twerge.It("text-gray-600 dark:text-gray-400")}>Shipping</span>
				<span class={twerge.It("text-gray-900 dark:text-white")}>
					if cart.Shipping == 0 {
						Free
					} else {
						${ fmt.Sprintf("%.2f", cart.Shipping) }
					}
				</span>
			</div>
			<div class={twerge.It("flex justify-between text-sm")}>
				<span class={twerge.It("text-gray-600 dark:text-gray-400")}>Tax</span>
				<span class={twerge.It("text-gray-900 dark:text-white")}>
					${ fmt.Sprintf("%.2f", cart.Tax) }
				</span>
			</div>
			<div class={twerge.It("border-t border-gray-200 dark:border-gray-700 pt-2")}>
				<div class={twerge.It("flex justify-between text-lg font-semibold")}>
					<span class={twerge.It("text-gray-900 dark:text-white")}>Total</span>
					<span class={twerge.It("text-gray-900 dark:text-white")}>
						${ fmt.Sprintf("%.2f", cart.Total) }
					</span>
				</div>
			</div>
		</div>
		
		<!-- Action Buttons -->
		<div class={twerge.It("space-y-2")}>
			<button class={twerge.It(
				"w-full py-3 bg-blue-600 text-white font-medium rounded-lg " +
				"hover:bg-blue-700 active:bg-blue-800 transform hover:scale-105 active:scale-95 " +
				"transition-all duration-200"
			)}>
				Checkout
			</button>
			<button 
				class={twerge.It(
					"w-full py-2 text-gray-600 dark:text-gray-400 hover:text-gray-900 " +
					"dark:hover:text-white transition-colors duration-200"
				)}
				@click="open = false"
			>
				Continue Shopping
			</button>
		</div>
	</div>
}

templ CartBadge(count int) {
	if count > 0 {
		<span 
			id="cart-count"
			class={twerge.It(
				"absolute -top-2 -right-2 bg-red-500 text-white text-xs font-bold " +
				"rounded-full w-5 h-5 flex items-center justify-center " +
				"animate-bounce transition-all duration-300"
			)}
		>
			{ strconv.Itoa(count) }
		</span>
	}
}

templ AddToCartButton(product types.Product, inCart bool, disabled bool) {
	<button 
		class={twerge.It(
			"w-full py-3 px-6 rounded-lg font-medium transition-all duration-200 " +
			"flex items-center justify-center space-x-2 " +
			twerge.If(disabled || !product.InStock,
				"bg-gray-300 text-gray-500 cursor-not-allowed dark:bg-gray-700 dark:text-gray-400",
				twerge.If(inCart,
					"bg-green-100 text-green-700 border border-green-300 " +
					"hover:bg-green-200 dark:bg-green-900 dark:text-green-300 " +
					"dark:border-green-700 dark:hover:bg-green-800",
					"bg-blue-600 text-white hover:bg-blue-700 " +
					"active:bg-blue-800 transform hover:scale-105 active:scale-95"
				)
			)
		)}
		disabled={disabled || !product.InStock}
		hx-post={fmt.Sprintf("/cart/add/%s", product.ID)}
		hx-target="#toast-container"
		hx-swap="afterbegin"
		hx-indicator=".cart-spinner"
	>
		<div class="cart-spinner htmx-indicator">
			<svg class={twerge.It("animate-spin h-5 w-5")} fill="none" viewBox="0 0 24 24">
				<circle class={twerge.It("opacity-25")} cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
				<path class={twerge.It("opacity-75")} fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
			</svg>
		</div>
		
		<span>
			if !product.InStock {
				Out of Stock
			} else if inCart {
				<svg class={twerge.It("w-5 h-5")} fill="currentColor" viewBox="0 0 20 20">
					<path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
				</svg>
				In Cart
			} else {
				<svg class={twerge.It("w-5 h-5")} fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
				</svg>
				Add to Cart
			}
		</span>
	</button>
}

templ QuickAddButton(productID string, size string) {
	<button 
		class={twerge.It(
			twerge.If(size == "small",
				"p-2 rounded-full",
				"px-4 py-2 rounded-lg"
			) +
			" bg-blue-600 text-white hover:bg-blue-700 " +
			"transform hover:scale-110 active:scale-95 " +
			"transition-all duration-200 shadow-lg hover:shadow-xl"
		)}
		hx-post={fmt.Sprintf("/cart/add/%s", productID)}
		hx-target="#toast-container"
		hx-swap="afterbegin"
		title="Quick Add to Cart"
	>
		<svg class={twerge.It(twerge.If(size == "small", "w-4 h-4", "w-5 h-5"))} fill="none" stroke="currentColor" viewBox="0 0 24 24">
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
		</svg>
	</button>
}