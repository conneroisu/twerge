package views

import (
	"github.com/conneroisu/twerge"
	"github.com/conneroisu/twerge/examples/ecommerce-catalog/types"
)

templ Layout(title string, cartCount int) {
	<!DOCTYPE html>
	<html lang="en" class={twerge.It("scroll-smooth")}>
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title } - Twerge Shop</title>
			<link rel="stylesheet" href="/static/styles.css"/>
			<script src="https://unpkg.com/htmx.org@2.0.4"></script>
			<script src="https://unpkg.com/htmx-ext-response-targets@2.0.1/response-targets.js"></script>
			<script src="https://unpkg.com/alpine@3.x.x/dist/cdn.min.js" defer></script>
		</head>
		<body 
			class={twerge.It("bg-gray-50 dark:bg-gray-900 text-gray-900 dark:text-gray-100 min-h-screen flex flex-col")}
			hx-ext="response-targets"
		>
			@Header(cartCount)
			
			<main class={twerge.It("flex-1 container mx-auto px-4 py-8")}>
				{ children... }
			</main>
			
			@Footer()
			
			<!-- Toast Container -->
			<div 
				id="toast-container" 
				class={twerge.It("fixed bottom-4 right-4 z-50 space-y-2")}
			></div>
			
			<!-- Cart Drawer -->
			<div id="cart-drawer"></div>
		</body>
	</html>
}

templ Header(cartCount int) {
	<header class={twerge.It("sticky top-0 z-40 bg-white dark:bg-gray-800 shadow-sm border-b border-gray-200 dark:border-gray-700")}>
		<nav class={twerge.It("container mx-auto px-4")}>
			<div class={twerge.It("flex items-center justify-between h-16")}>
				<!-- Logo -->
				<a 
					href="/" 
					class={twerge.It("flex items-center space-x-2 text-xl font-bold text-gray-900 dark:text-white hover:text-blue-600 dark:hover:text-blue-400 transition-colors duration-200")}
				>
					<svg class={twerge.It("w-8 h-8")} fill="currentColor" viewBox="0 0 24 24">
						<path d="M19 7h-3V6a4 4 0 00-8 0v1H5a1 1 0 00-1 1v11a3 3 0 003 3h10a3 3 0 003-3V8a1 1 0 00-1-1zM10 6a2 2 0 014 0v1h-4V6zm8 13a1 1 0 01-1 1H7a1 1 0 01-1-1V9h2v1a1 1 0 002 0V9h4v1a1 1 0 002 0V9h2v10z"/>
					</svg>
					<span>Twerge Shop</span>
				</a>
				
				<!-- Search Bar -->
				<div class={twerge.It("hidden md:flex flex-1 max-w-lg mx-8")}>
					<div class={twerge.It("relative w-full")}>
						<input 
							type="search"
							placeholder="Search products..."
							class={twerge.It("w-full pl-10 pr-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200")}
							hx-post="/catalog/filter"
							hx-trigger="input changed delay:500ms"
							hx-target="#product-grid"
							hx-swap="innerHTML"
							name="search"
						/>
						<svg class={twerge.It("absolute left-3 top-2.5 w-5 h-5 text-gray-400")} fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
						</svg>
					</div>
				</div>
				
				<!-- Nav Items -->
				<div class={twerge.It("flex items-center space-x-6")}>
					<!-- Categories Dropdown -->
					<div class={twerge.It("relative group")} x-data="{ open: false }">
						<button 
							@click="open = !open"
							class={twerge.It("flex items-center space-x-1 text-gray-700 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white transition-colors duration-200")}
						>
							<span>Categories</span>
							<svg class={twerge.It("w-4 h-4 transition-transform duration-200")} :class="open && 'rotate-180'" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
							</svg>
						</button>
						<div 
							x-show="open"
							@click.outside="open = false"
							x-transition
							class={twerge.It("absolute top-full left-0 mt-2 w-56 bg-white dark:bg-gray-800 rounded-lg shadow-lg border border-gray-200 dark:border-gray-700 py-2")}
						>
							for _, category := range types.Categories {
								<a 
									href={templ.URL("/?category=" + category)}
									class={twerge.It("block px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors duration-200")}
								>
									{ category }
								</a>
							}
						</div>
					</div>
					
					<!-- Wishlist -->
					<button class={twerge.It("relative text-gray-700 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white transition-colors duration-200")}>
						<svg class={twerge.It("w-6 h-6")} fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
						</svg>
					</button>
					
					<!-- Cart -->
					<button 
						class={twerge.It("relative text-gray-700 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white transition-colors duration-200")}
						hx-get="/cart"
						hx-target="#cart-drawer"
						hx-swap="innerHTML"
					>
						<svg class={twerge.It("w-6 h-6")} fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
						</svg>
						if cartCount > 0 {
							<span 
								id="cart-count"
								class={twerge.It("absolute -top-2 -right-2 bg-red-500 text-white text-xs font-bold rounded-full w-5 h-5 flex items-center justify-center animate-pulse")}
							>
								{ templ.Str(cartCount) }
							</span>
						}
					</button>
					
					<!-- Theme Toggle -->
					<button 
						x-data="{ dark: localStorage.getItem('theme') === 'dark' }"
						@click="dark = !dark; document.documentElement.classList.toggle('dark'); localStorage.setItem('theme', dark ? 'dark' : 'light')"
						class={twerge.It("text-gray-700 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white transition-colors duration-200")}
					>
						<svg x-show="!dark" class={twerge.It("w-6 h-6")} fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
						</svg>
						<svg x-show="dark" class={twerge.It("w-6 h-6")} fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
						</svg>
					</button>
				</div>
			</div>
		</nav>
	</header>
}

templ Footer() {
	<footer class={twerge.It("bg-white dark:bg-gray-800 border-t border-gray-200 dark:border-gray-700 mt-16")}>
		<div class={twerge.It("container mx-auto px-4 py-8")}>
			<div class={twerge.It("grid grid-cols-1 md:grid-cols-4 gap-8")}>
				<!-- About -->
				<div>
					<h3 class={twerge.It("font-semibold text-gray-900 dark:text-white mb-4")}>About Twerge Shop</h3>
					<p class={twerge.It("text-sm text-gray-600 dark:text-gray-400")}>
						A modern e-commerce demo showcasing the power of Twerge for TailwindCSS optimization in Go templ applications.
					</p>
				</div>
				
				<!-- Quick Links -->
				<div>
					<h3 class={twerge.It("font-semibold text-gray-900 dark:text-white mb-4")}>Quick Links</h3>
					<ul class={twerge.It("space-y-2 text-sm")}>
						<li><a href="/about" class={twerge.It("text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white transition-colors duration-200")}>About Us</a></li>
						<li><a href="/contact" class={twerge.It("text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white transition-colors duration-200")}>Contact</a></li>
						<li><a href="/shipping" class={twerge.It("text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white transition-colors duration-200")}>Shipping Info</a></li>
						<li><a href="/returns" class={twerge.It("text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white transition-colors duration-200")}>Returns</a></li>
					</ul>
				</div>
				
				<!-- Categories -->
				<div>
					<h3 class={twerge.It("font-semibold text-gray-900 dark:text-white mb-4")}>Categories</h3>
					<ul class={twerge.It("space-y-2 text-sm")}>
						for i, category := range types.Categories {
							if i < 4 {
								<li><a href={templ.URL("/?category=" + category)} class={twerge.It("text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white transition-colors duration-200")}>{ category }</a></li>
							}
						}
					</ul>
				</div>
				
				<!-- Newsletter -->
				<div>
					<h3 class={twerge.It("font-semibold text-gray-900 dark:text-white mb-4")}>Newsletter</h3>
					<p class={twerge.It("text-sm text-gray-600 dark:text-gray-400 mb-4")}>
						Subscribe for exclusive deals and new products.
					</p>
					<form class={twerge.It("flex space-x-2")}>
						<input 
							type="email" 
							placeholder="Your email"
							class={twerge.It("flex-1 px-3 py-2 text-sm rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent")}
						/>
						<button 
							type="submit"
							class={twerge.It("px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors duration-200")}
						>
							Subscribe
						</button>
					</form>
				</div>
			</div>
			
			<div class={twerge.It("mt-8 pt-8 border-t border-gray-200 dark:border-gray-700 text-center text-sm text-gray-600 dark:text-gray-400")}>
				<p>&copy; 2024 Twerge Shop. Built with <a href="https://github.com/conneroisu/twerge" class={twerge.It("text-blue-600 hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300")}>Twerge</a> and ❤️</p>
			</div>
		</div>
	</footer>
}

templ Toast(message string, ttype string) {
	<div 
		class={twerge.It(
			"flex items-center space-x-3 px-4 py-3 rounded-lg shadow-lg border animate-slide-in-right " +
			twerge.If(ttype == "success",
				"bg-green-50 dark:bg-green-900/20 border-green-200 dark:border-green-800 text-green-800 dark:text-green-200",
				twerge.If(ttype == "error",
					"bg-red-50 dark:bg-red-900/20 border-red-200 dark:border-red-800 text-red-800 dark:text-red-200",
					"bg-blue-50 dark:bg-blue-900/20 border-blue-200 dark:border-blue-800 text-blue-800 dark:text-blue-200"
				)
			)
		)}
		x-data="{ show: true }"
		x-show="show"
		x-init="setTimeout(() => show = false, 3000)"
		x-transition
	>
		if ttype == "success" {
			<svg class={twerge.It("w-5 h-5")} fill="currentColor" viewBox="0 0 20 20">
				<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
			</svg>
		} else if ttype == "error" {
			<svg class={twerge.It("w-5 h-5")} fill="currentColor" viewBox="0 0 20 20">
				<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
			</svg>
		} else {
			<svg class={twerge.It("w-5 h-5")} fill="currentColor" viewBox="0 0 20 20">
				<path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
			</svg>
		}
		<span class={twerge.It("text-sm font-medium")}>{ message }</span>
	</div>
}