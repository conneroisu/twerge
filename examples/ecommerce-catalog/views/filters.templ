package views

import (
	"fmt"
	"strconv"
	"github.com/conneroisu/twerge"
	"github.com/conneroisu/twerge/examples/ecommerce-catalog/types"
)

templ FilterSidebar(filters types.FilterState, totalProducts int, categoryCounts map[string]int) {
	<div class={twerge.It(
		"w-full lg:w-80 bg-white dark:bg-gray-800 rounded-lg shadow-sm " +
		"border border-gray-200 dark:border-gray-700 p-6 space-y-6"
	)}>
		<div class={twerge.It("flex items-center justify-between")}>
			<h3 class={twerge.It("text-lg font-semibold text-gray-900 dark:text-white")}>
				Filters
			</h3>
			<div class={twerge.It("flex items-center space-x-2")}>
				<span 
					id="product-count"
					class={twerge.It(
						"text-sm text-gray-500 dark:text-gray-400 " +
						"transition-all duration-300"
					)}
				>
					{ strconv.Itoa(totalProducts) } products
				</span>
				<button 
					class={twerge.It("text-sm text-blue-600 hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300")}
					hx-post="/catalog/filter"
					hx-vals="{}"
					hx-target="#catalog-content"
					hx-swap="innerHTML"
				>
					Clear All
				</button>
			</div>
		</div>

		<form 
			hx-post="/catalog/filter"
			hx-target="#catalog-content"
			hx-swap="innerHTML"
			hx-trigger="change, input delay:300ms"
			hx-indicator="#filter-loading"
		>
			@CategoryFilter(filters.Categories, categoryCounts)
			@PriceRangeFilter(filters.PriceRange)
			@AvailabilityFilter(filters.InStock, filters.OnSale)
			@RatingFilter(filters.Ratings)
			@SortFilter(filters.SortBy)
		</form>
		
		<!-- Loading Indicator -->
		<div 
			id="filter-loading" 
			class={twerge.It("htmx-indicator flex items-center justify-center py-4")}
		>
			<div class={twerge.It("animate-spin rounded-full h-6 w-6 border-b-2 border-blue-600")}></div>
		</div>
	</div>
}

templ CategoryFilter(selectedCategories []string, categoryCounts map[string]int) {
	<div class={twerge.It("space-y-3")}>
		<h4 class={twerge.It("font-medium text-gray-900 dark:text-white")}>Category</h4>
		<div class={twerge.It("space-y-2 max-h-48 overflow-y-auto")}>
			for _, category := range types.Categories {
				@FilterCheckbox(
					category,
					isSelected(selectedCategories, category),
					categoryCounts[category],
					"categories"
				)
			}
		</div>
	</div>
}

templ FilterCheckbox(label string, checked bool, count int, fieldName string) {
	<label class={twerge.It(
		"flex items-center justify-between cursor-pointer group " +
		"p-2 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 " +
		"transition-colors duration-200"
	)}>
		<div class={twerge.It("flex items-center space-x-3")}>
			<input 
				type="checkbox" 
				name={fieldName}
				value={label}
				checked={checked}
				class={twerge.It(
					"w-4 h-4 text-blue-600 border-gray-300 dark:border-gray-600 " +
					"rounded focus:ring-blue-500 dark:focus:ring-blue-600 " +
					"dark:bg-gray-700 transition-colors duration-200"
				)}
			/>
			<span class={twerge.It(
				"text-sm text-gray-700 dark:text-gray-300 " +
				"group-hover:text-gray-900 dark:group-hover:text-white " +
				"transition-colors duration-200"
			)}>
				{ label }
			</span>
		</div>
		<span class={twerge.It(
			"text-xs text-gray-500 dark:text-gray-400 " +
			"bg-gray-100 dark:bg-gray-600 px-2 py-1 rounded-full " +
			twerge.If(count == 0, "opacity-50", "")
		)}>
			{ strconv.Itoa(count) }
		</span>
	</label>
}

templ PriceRangeFilter(priceRange [2]float64) {
	<div class={twerge.It("space-y-3")}>
		<h4 class={twerge.It("font-medium text-gray-900 dark:text-white")}>Price Range</h4>
		
		<div class={twerge.It("space-y-4")}>
			<!-- Price Inputs -->
			<div class={twerge.It("grid grid-cols-2 gap-3")}>
				<div>
					<label class={twerge.It("block text-xs text-gray-500 dark:text-gray-400 mb-1")}>Min</label>
					<input 
						type="number"
						name="price_min"
						value={fmt.Sprintf("%.0f", priceRange[0])}
						min="0"
						step="1"
						class={twerge.It("w-full px-3 py-2 text-sm border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent")}
						placeholder="0"
					/>
				</div>
				<div>
					<label class={twerge.It("block text-xs text-gray-500 dark:text-gray-400 mb-1")}>Max</label>
					<input 
						type="number"
						name="price_max"
						value={fmt.Sprintf("%.0f", priceRange[1])}
						min="0"
						step="1"
						class={twerge.It("w-full px-3 py-2 text-sm border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent")}
						placeholder="1000"
					/>
				</div>
			</div>
			
			<!-- Range Slider -->
			<div class={twerge.It("px-2")}>
				<input 
					type="range"
					name="price_range"
					min="0"
					max="1000"
					value={fmt.Sprintf("%.0f", priceRange[1])}
					class={twerge.It("w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer slider")}
				/>
				<div class={twerge.It("flex justify-between text-xs text-gray-500 dark:text-gray-400 mt-1")}>
					<span>$0</span>
					<span>$1000+</span>
				</div>
			</div>
			
			<!-- Quick Price Filters -->
			<div class={twerge.It("flex flex-wrap gap-2")}>
				@PriceQuickFilter("Under $25", [2]float64{0, 25}, priceRange)
				@PriceQuickFilter("$25 - $50", [2]float64{25, 50}, priceRange)
				@PriceQuickFilter("$50 - $100", [2]float64{50, 100}, priceRange)
				@PriceQuickFilter("$100+", [2]float64{100, 1000}, priceRange)
			</div>
		</div>
	</div>
}

templ PriceQuickFilter(label string, range [2]float64, currentRange [2]float64) {
	<button 
		type="button"
		class={twerge.It(
			"px-3 py-1 text-xs rounded-full border transition-colors duration-200 " +
			twerge.If(currentRange[0] == range[0] && currentRange[1] == range[1],
				"bg-blue-600 text-white border-blue-600",
				"bg-white dark:bg-gray-700 text-gray-700 dark:text-gray-300 border-gray-300 dark:border-gray-600 hover:border-gray-400 dark:hover:border-gray-500"
			)
		)}
		hx-post="/catalog/filter"
		hx-vals={fmt.Sprintf(`{"price_min": "%.0f", "price_max": "%.0f"}`, range[0], range[1])}
		hx-target="#catalog-content"
		hx-swap="innerHTML"
	>
		{ label }
	</button>
}

templ AvailabilityFilter(inStock *bool, onSale *bool) {
	<div class={twerge.It("space-y-3")}>
		<h4 class={twerge.It("font-medium text-gray-900 dark:text-white")}>Availability</h4>
		<div class={twerge.It("space-y-2")}>
			<label class={twerge.It("flex items-center space-x-3 cursor-pointer")}>
				<input 
					type="checkbox"
					name="in_stock"
					value="true"
					checked={inStock != nil && *inStock}
					class={twerge.It("w-4 h-4 text-blue-600 border-gray-300 dark:border-gray-600 rounded focus:ring-blue-500 dark:focus:ring-blue-600 dark:bg-gray-700")}
				/>
				<span class={twerge.It("text-sm text-gray-700 dark:text-gray-300")}>In Stock</span>
			</label>
			<label class={twerge.It("flex items-center space-x-3 cursor-pointer")}>
				<input 
					type="checkbox"
					name="on_sale"
					value="true"
					checked={onSale != nil && *onSale}
					class={twerge.It("w-4 h-4 text-blue-600 border-gray-300 dark:border-gray-600 rounded focus:ring-blue-500 dark:focus:ring-blue-600 dark:bg-gray-700")}
				/>
				<span class={twerge.It("text-sm text-gray-700 dark:text-gray-300")}>On Sale</span>
			</label>
		</div>
	</div>
}

templ RatingFilter(selectedRatings []int) {
	<div class={twerge.It("space-y-3")}>
		<h4 class={twerge.It("font-medium text-gray-900 dark:text-white")}>Customer Rating</h4>
		<div class={twerge.It("space-y-2")}>
			for rating := 5; rating >= 1; rating-- {
				@RatingOption(rating, isRatingSelected(selectedRatings, rating))
			}
		</div>
	</div>
}

templ RatingOption(rating int, selected bool) {
	<label class={twerge.It("flex items-center space-x-3 cursor-pointer group hover:bg-gray-50 dark:hover:bg-gray-700 p-2 rounded-lg transition-colors duration-200")}>
		<input 
			type="checkbox"
			name="ratings"
			value={strconv.Itoa(rating)}
			checked={selected}
			class={twerge.It("w-4 h-4 text-blue-600 border-gray-300 dark:border-gray-600 rounded focus:ring-blue-500 dark:focus:ring-blue-600 dark:bg-gray-700")}
		/>
		<div class={twerge.It("flex items-center space-x-1")}>
			for i := 1; i <= 5; i++ {
				<svg 
					class={twerge.It(
						"w-4 h-4 " +
						twerge.If(i <= rating, "text-yellow-400", "text-gray-300 dark:text-gray-600")
					)}
					fill="currentColor"
					viewBox="0 0 20 20"
				>
					<path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
				</svg>
			}
			<span class={twerge.It("text-sm text-gray-600 dark:text-gray-400 ml-2")}>
				& up
			</span>
		</div>
	</label>
}

templ SortFilter(selectedSort string) {
	<div class={twerge.It("space-y-3")}>
		<h4 class={twerge.It("font-medium text-gray-900 dark:text-white")}>Sort By</h4>
		<select 
			name="sort_by"
			class={twerge.It("w-full px-3 py-2 text-sm border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent")}
		>
			<option value="relevance" selected={selectedSort == "relevance"}>Relevance</option>
			<option value="price_asc" selected={selectedSort == "price_asc"}>Price: Low to High</option>
			<option value="price_desc" selected={selectedSort == "price_desc"}>Price: High to Low</option>
			<option value="rating" selected={selectedSort == "rating"}>Highest Rated</option>
			<option value="newest" selected={selectedSort == "newest"}>Newest</option>
			<option value="name_asc" selected={selectedSort == "name_asc"}>Name: A to Z</option>
			<option value="name_desc" selected={selectedSort == "name_desc"}>Name: Z to A</option>
		</select>
	</div>
}

templ ActiveFilters(filters types.FilterState) {
	if hasActiveFilters(filters) {
		<div class={twerge.It("flex flex-wrap items-center gap-2 mb-6")}>
			<span class={twerge.It("text-sm font-medium text-gray-700 dark:text-gray-300")}>
				Active filters:
			</span>
			
			<!-- Category filters -->
			for _, category := range filters.Categories {
				@FilterTag(category, "category", category)
			}
			
			<!-- Price filter -->
			if filters.PriceRange[0] > 0 || filters.PriceRange[1] < 1000 {
				@FilterTag(
					fmt.Sprintf("$%.0f - $%.0f", filters.PriceRange[0], filters.PriceRange[1]),
					"price",
					"price"
				)
			}
			
			<!-- Availability filters -->
			if filters.InStock != nil && *filters.InStock {
				@FilterTag("In Stock", "availability", "in_stock")
			}
			if filters.OnSale != nil && *filters.OnSale {
				@FilterTag("On Sale", "availability", "on_sale")
			}
			
			<!-- Rating filters -->
			for _, rating := range filters.Ratings {
				@FilterTag(
					fmt.Sprintf("%d+ Stars", rating),
					"rating",
					strconv.Itoa(rating)
				)
			}
			
			<!-- Clear all button -->
			<button 
				class={twerge.It("text-sm text-red-600 hover:text-red-700 dark:text-red-400 dark:hover:text-red-300 font-medium")}
				hx-post="/catalog/filter"
				hx-vals="{}"
				hx-target="#catalog-content"
				hx-swap="innerHTML"
			>
				Clear All
			</button>
		</div>
	}
}

templ FilterTag(label string, filterType string, value string) {
	<span class={twerge.It("inline-flex items-center space-x-1 px-3 py-1 bg-blue-100 dark:bg-blue-900/30 text-blue-800 dark:text-blue-200 text-sm font-medium rounded-full")}>
		<span>{ label }</span>
		<button 
			class={twerge.It("ml-1 text-blue-600 hover:text-blue-800 dark:text-blue-300 dark:hover:text-blue-100")}
			hx-post="/catalog/filter"
			hx-vals={fmt.Sprintf(`{"remove_filter": "%s", "remove_value": "%s"}`, filterType, value)}
			hx-target="#catalog-content"
			hx-swap="innerHTML"
		>
			<svg class={twerge.It("w-3 h-3")} fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
			</svg>
		</button>
	</span>
}

templ MobileFilterToggle() {
	<button 
		class={twerge.It("lg:hidden flex items-center space-x-2 px-4 py-2 bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors duration-200")}
		x-data="{ filtersOpen: false }"
		@click="filtersOpen = !filtersOpen"
	>
		<svg class={twerge.It("w-5 h-5")} fill="none" stroke="currentColor" viewBox="0 0 24 24">
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.414A1 1 0 013 6.707V4z"/>
		</svg>
		<span class={twerge.It("text-sm font-medium")}>Filters</span>
	</button>
}

func isSelected(slice []string, item string) bool {
	for _, s := range slice {
		if s == item {
			return true
		}
	}
	return false
}

func isRatingSelected(ratings []int, rating int) bool {
	for _, r := range ratings {
		if r == rating {
			return true
		}
	}
	return false
}

func hasActiveFilters(filters types.FilterState) bool {
	return len(filters.Categories) > 0 ||
		filters.PriceRange[0] > 0 ||
		filters.PriceRange[1] < 1000 ||
		(filters.InStock != nil && *filters.InStock) ||
		(filters.OnSale != nil && *filters.OnSale) ||
		len(filters.Ratings) > 0
}